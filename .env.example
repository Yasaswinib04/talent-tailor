# ---------------------------------------------------------------------------
# CRED HR — Talent Engine
# Copy to .env (backend) and frontend/.env.production, then fill in.
# Every variable below is read by the code; nothing else is.
# ---------------------------------------------------------------------------

# --- Backend (backend/server.py) ---------------------------------------------

# MONGO_URL: MongoDB connection string. Required — the API refuses to start
# without it. Local: mongodb://localhost:27017
MONGO_URL="mongodb://localhost:27017"

# DB_NAME: Database to use inside that Mongo instance. Required.
# Seed data (4 roles, 20 candidates) is inserted on first startup if empty.
DB_NAME="cred_hr"

# CORS_ORIGINS: Comma-separated browser origins allowed to call the API.
# REQUIRED whenever the frontend is served from a different origin than the API.
# Sessions live in a cookie, and browsers refuse to send cookies to a wildcard
# origin — so with "*" here, signing in fails with what looks like a network
# error. Set it to your frontend's exact origin.
# Only leave it as "*" if the app and API share one origin behind a proxy.
# Example: CORS_ORIGINS="https://hr.cred.club"
CORS_ORIGINS="http://localhost:3000"


# ADMIN_EMAIL / ADMIN_PASSWORD: used ONCE, on first startup, to create the first
# admin account when no users exist. There is no default password on purpose —
# leave these unset and nobody can sign in. Password must be 12+ characters.
# After the first recruiter signs in, add colleagues via the app and you can
# remove these from the environment.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# COOKIE_SECURE: set to "true" in any environment served over HTTPS. Marks the
# session cookie Secure + SameSite=None so it works across origins. Leave unset
# for local http development.
COOKIE_SECURE=""


# SEED_DEMO_DATA: set to "true" ONLY for a demo or a local sandbox. It inserts
# 4 sample roles and 20 fabricated candidates on first startup. Leave unset in
# production — a recruiter opening the app to 20 invented people is worse than
# an empty pipeline.
SEED_DEMO_DATA=""


# --- Frontend (frontend/) ----------------------------------------------------
#
# NOTE: this one is BUILD-TIME, not runtime. Create React App inlines it into
# the bundle during `npm run build`, so it must be set *before* you build.
# Changing it later means rebuilding — restarting the server does nothing.
#
# Put it in frontend/.env.production (committed; it's a public URL, not a
# secret) or export it in your build step.
#
# REACT_APP_BACKEND_URL: Origin of the backend, with no trailing slash and no
# /api suffix — the client appends /api itself.
# Example: REACT_APP_BACKEND_URL=https://api.cred-hr.example.com
REACT_APP_BACKEND_URL="http://localhost:8001"
