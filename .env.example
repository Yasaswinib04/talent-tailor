# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# DATABASE_URL: PostgreSQL connection string for session + analysis storage.
# Format: postgresql://user:password@host:5432/dbname
# Get from: Railway → your PostgreSQL service → Connect tab
DATABASE_URL=""

# SUPABASE_URL: Supabase project URL for resume file storage.
# Format: https://xxxxxxxxxxxx.supabase.co
# Get from: https://supabase.com → your project → Settings → API → Project URL
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Admin key for Supabase storage operations.
# Get from: https://supabase.com → your project → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=""
