# ---------------------------------------------------------------------------
# Backend (backend/.env) — read by backend/server.py
# ---------------------------------------------------------------------------

# MONGO_URL: MongoDB connection string. Required.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URL="mongodb://localhost:27017"

# DB_NAME: Database name to use inside that MongoDB. Required.
DB_NAME="cred_hr"

# HR_ACCESS_CODE: Required. Shared code recruiters type to open the workspace.
# Every recruiter endpoint (jobs, candidates, analytics) rejects requests
# without it, so candidate contact details are not world-readable.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
HR_ACCESS_CODE=""

# ALLOWED_ORIGINS: Comma-separated browser origins allowed to call the API.
# Must include wherever the frontend is served from.
# Defaults to http://localhost:3000 when unset.
ALLOWED_ORIGINS="http://localhost:3000"


# ---------------------------------------------------------------------------
# Frontend (frontend/.env) — read at BUILD time by Create React App
# ---------------------------------------------------------------------------

# REACT_APP_BACKEND_URL: Base URL of the backend, with no trailing /api.
# The build fails fast if this is missing, rather than posting to "undefined/api".
REACT_APP_BACKEND_URL="http://localhost:8000"
