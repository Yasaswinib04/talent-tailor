# ---- backend/.env ----
# MONGO_URL: MongoDB connection string. Required — the API will not start without it.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URL="mongodb://localhost:27017"

# DB_NAME: database name to use inside that MongoDB instance. Required.
DB_NAME="talent_tailor"

# OPENROUTER_API_KEY: enables LLM resume parsing and JD extraction. Optional —
# without it the app falls back to backend/skills.py, a 119-skill taxonomy with
# token-boundary matching, plus regex extraction of name, e-mail, phone, title,
# employer, years, CTC, notice period and degree. That fallback reads less
# nuance than a model does, but it is deterministic and costs nothing, and a
# resume parsed this way still de-duplicates correctly because it recovers the
# address. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Model selection: both jobs default to the Opus tier. Extraction quality is
# the product, and a fully parsed role (1 JD + 50 resumes) costs ~₹125 against
# ₹1,999 revenue — never cheap out here to save ₹100/role.
# The trade-off, per resume (~3k tokens in / ~500 out, ₹88/$):
#   anthropic/claude-opus-5   ~₹2.4   5-15s  top tier — the default
#   anthropic/claude-sonnet-5 ~₹1.0   3-8s   step-down if burn ever matters
#   google/gemini-flash tier  ~₹0.2   1-3s   floor for high-volume/free traffic
# Verify exact model ids and live pricing in the OpenRouter dashboard — tier
# matters, version number doesn't.
OPENROUTER_MODEL_RESUME="anthropic/claude-opus-5"
OPENROUTER_MODEL_JD="anthropic/claude-opus-5"
# OPENROUTER_MODEL: optional single override for both when set (the specific
# vars above win over it).
OPENROUTER_MODEL=""

# SECRET_KEY: signs auth tokens. Set to any long random string; rotating it
# signs every user out. If unset, one is derived from MONGO_URL (works, but
# changing the DB password then also invalidates sessions).
SECRET_KEY=""

# ---- Payments (rails are picked at runtime, in this order) ----
# 1. Razorpay checkout: set BOTH keys (dashboard.razorpay.com → Settings → API
#    Keys). Buyer pays in-app, signature is verified server-side, shortlist
#    auto-unlocks. Use rzp_test_* keys to rehearse, rzp_live_* to charge.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# 2. Direct UPI (used only when Razorpay keys are unset): the unlock modal
#    shows this VPA + a upi:// deep link; buyer pays, you send UNLOCK_CODE.
UPI_VPA=""
# Show the name the buyer's own UPI app will display at confirmation. A mismatch
# between this and the bank's registered name reads as a scam at the exact
# moment someone is paying.
UPI_PAYEE_NAME="Talent Tailor"

# Where a buyer sends proof of a manual UPI payment. Email (anything with "@")
# renders as mailto; a phone number renders as a wa.me link — include the
# country code, digits only are extracted, and a personal WhatsApp account works
# (Business is not required). Leave unset and the modal stops asking for a
# screenshot at all, rather than naming a channel that doesn't exist.
# This is public: every buyer sees it. Don't use a number or address you'd
# rather not hand to strangers.
SUPPORT_CONTACT=""

# UNLOCK_CODE: the manual-payment bridge. A buyer pays you (UPI/invoice), you
# share this code, they enter it on the job page to unlock the full shortlist.
# Unlocking is disabled while unset. Rotate it after each sale if you want
# one-time codes.
UNLOCK_CODE=""

# UNLOCK_PRICE_INR: price shown in unlock messaging. Default 1999.
UNLOCK_PRICE_INR="1999"

# ---- Product analytics (PostHog) ----
# POSTHOG_API_KEY: server-side event capture. Analytics is entirely disabled
# while unset, which is what you want locally and in CI — no code path changes,
# events are simply dropped. Get the value from PostHog → Settings → Project →
# Project API Key (the "phc_..." one; it is the same key the frontend uses and
# is safe to expose in a browser bundle by design).
# Free tier is ~1M events/month, which this app will not come close to.
POSTHOG_API_KEY=""
# POSTHOG_HOST: region of your PostHog project. US default; use
# https://eu.i.posthog.com for an EU project.
POSTHOG_HOST="https://us.i.posthog.com"

# SEED_DEMO_DATA: "1" seeds 4 fictional roles + 20 candidates into an EMPTY
# database under a "demo" workspace on startup. Leave unset in production —
# new accounts get an in-app "load sample data" option instead.
SEED_DEMO_DATA="0"

# CORS_ORIGINS: comma-separated allowed origins. Default "*" (fine for local).
# In production set it to the deployed frontend origin.
CORS_ORIGINS="*"

# ADMIN_KEY: gates the operator endpoints (X-Admin-Key header): GET
# /api/visitors lead list and GET /api/admin/llm-usage per-account AI burn.
# Both are disabled while unset.
ADMIN_KEY=""

# USD_INR: display-only conversion rate for AI cost views. OpenRouter reports
# per-call cost in USD; the app stores USD and converts at this rate.
USD_INR="88"


# ---- frontend/.env ----
# REACT_APP_BACKEND_URL: origin the React app calls for /api routes. Required.
# CRA only exposes variables prefixed with REACT_APP_, and only reads them at build time —
# restart `npm start` after changing this.
REACT_APP_BACKEND_URL="http://localhost:8000"

# REACT_APP_POSTHOG_KEY: same Project API Key as POSTHOG_API_KEY above. Enables
# pageviews and session replay. Leave empty to disable the browser layer
# entirely (initAnalytics() returns early and every track() call is a no-op).
# Session replay must ALSO be switched on in PostHog → Settings → Project →
# Session Replay; the key alone does not start recording.
# Privacy: all text inputs are masked, and candidate name/email/phone are
# marked [data-private] and masked too, so recordings never carry resume PII.
# Mark any new candidate-identity UI with data-private to keep that true.
REACT_APP_POSTHOG_KEY=""
REACT_APP_POSTHOG_HOST="https://us.i.posthog.com"
