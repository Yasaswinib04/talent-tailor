{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user basic information and preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "Analysis": {
      "title": "Analysis Result",
      "description": "Stores the result of a Resume vs JD analysis.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "jdContent": { "type": "string" },
        "candidates": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role", "jdContent", "candidates", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user profiles."
    },
    "/analyses/{analysisId}": {
      "schema": "Analysis",
      "description": "Analysis results linked to users."
    }
  }
}
