# Build-time only — CRA inlines this into the bundle during `npm run build`.
# Not a secret (it's a public URL), so it is committed on purpose: an unset
# value silently builds a bundle that calls "undefined/api" and fails at runtime.
# Override per environment by exporting REACT_APP_BACKEND_URL before building.
REACT_APP_BACKEND_URL=http://localhost:8001
